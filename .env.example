# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Primary model: Azure AI Foundry ---------------------------------------
# Paste the target URI exactly as the Foundry portal shows it. The client works
# out the rest of the route, so any of these forms are fine:
#   https://<resource>.services.ai.azure.com
#   https://<resource>.services.ai.azure.com/models/chat/completions?api-version=...
#   https://<resource>.services.ai.azure.com/openai/v1          (GPT-5 and friends)
AZURE_API_URL=https://sg-geco-ai-general-resources-foundry.services.ai.azure.com/openai/v1
AZURE_API_KEY=replace_me
# The deployment name from the portal, not the base model name.
AZURE_DEPLOYMENT=gpt-5
# Only needed on the /models and /openai/deployments routes. The /openai/v1
# route ignores it.
AZURE_API_VERSION=2024-05-01-preview

# To use the older deployments route instead, set the deployment path and the
# client will build /openai/deployments/<name>/chat/completions for you:
# AZURE_DEPLOYMENT_PATH=gpt-5

# --- Fallback models (optional) --------------------------------------------
# Tried in numeric order when the primary fails. Blocks whose key is still a
# placeholder are skipped, so leaving these as-is costs nothing.
LLM_1_API_URL=https://api-inference.bitdeer.ai/v1/chat/completions
LLM_1_API_KEY=your_key_here
LLM_1_MODEL=openai/gpt-oss-120b
LLM_1_AUTH_TYPE=bearer

LLM_2_API_URL=https://api-inference.bitdeer.ai/v1/chat/completions
LLM_2_API_KEY=your_key_here
LLM_2_MODEL=deepseek-ai/DeepSeek-V3.2
LLM_2_AUTH_TYPE=bearer

# --- Request behaviour ------------------------------------------------------
LLM_TIMEOUT_SECONDS=120
LLM_RETRIES=1
LLM_BACKOFF_SECONDS=1.2
LLM_FAILOVER_ON_STATUS=401,403,404,408,429,500-599
LLM_DEBUG=1

# --- Shared -----------------------------------------------------------------
COMPANY_NAME=Cashew4Nuts
CURRENCY=SGD
DATA_DIR=data/Team_Cashew_Synthetic_Data
FLASK_DEBUG=0

# --- Clarity (internal analytics, port 5000) --------------------------------
# Reasoning depth is worth the latency here; only staff wait on it.
CLARITY_PORT=5000
CLARITY_REASONING_EFFORT=medium
CLARITY_VERBOSITY=medium
CLARITY_TEMPERATURE=0.2
CLARITY_MAX_TOKENS=4000
CLARITY_MAX_TOOL_ROUNDS=3

# --- Nibbles (customer facing, port 5001) -----------------------------------
# Customers wait in real time, so keep reasoning minimal for fast first tokens.
NIBBLES_PORT=5001
NIBBLES_REASONING_EFFORT=minimal
NIBBLES_VERBOSITY=low
NIBBLES_TEMPERATURE=0.55
NIBBLES_MAX_TOKENS=700
NIBBLES_MAX_ITEMS=5
LEADS_FILE=data/runtime/nibbles_leads.csv
