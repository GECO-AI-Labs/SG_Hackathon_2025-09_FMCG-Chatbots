# ---------------------------------------------------------------------------
# Copy to .env and fill in the keys. Never commit .env.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Primary: gpt-5.4 on Azure AI Foundry (Responses API) ------------------
# This deployment is served over /openai/v1/responses, which is a different
# protocol from chat/completions: it takes `input` instead of `messages` and
# streams typed response.* events. The client detects that from the URL and
# translates automatically, so paste the endpoint exactly as the portal shows.
AZURE_API_URL=https://sg-geco-ai-general-resources-foundry.services.ai.azure.com/openai/v1/responses
AZURE_API_KEY=
# The deployment name from the portal, not the base model name.
AZURE_DEPLOYMENT=SG-Geco-AI-General-Resources-Foundry-gpt-5.4

# --- Fallback: DeepSeek-V3.2 (Chat Completions) ----------------------------
# Same resource, different protocol. The client switches wire format per
# provider, so failover across the two works without any extra configuration.
# Leave the key blank to disable this fallback entirely.
LLM_1_API_URL=https://sg-geco-ai-general-resources-foundry.services.ai.azure.com/openai/v1/chat/completions
LLM_1_API_KEY=
LLM_1_MODEL=DeepSeek-V3.2
LLM_1_AUTH_TYPE=api-key

# --- Request behaviour ------------------------------------------------------
LLM_TIMEOUT_SECONDS=120
LLM_RETRIES=1
LLM_BACKOFF_SECONDS=1.2
LLM_FAILOVER_ON_STATUS=401,403,404,408,429,500-599
LLM_DEBUG=1

# --- Reverse proxy ----------------------------------------------------------
# The docker network Nginx Proxy Manager runs on, so it can reach both
# containers by name. Confirm with:
#   docker inspect proxy-app-1 -f '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{end}}'
PROXY_NETWORK=proxy_default

# --- Shared -----------------------------------------------------------------
COMPANY_NAME=Cashew4Nuts
CURRENCY=SGD
DATA_DIR=data/Team_Cashew_Synthetic_Data
FLASK_DEBUG=0
# Set to 1 only after TLS is live. On plain HTTP the browser drops a secure
# cookie and sessions stop working silently.
COOKIE_SECURE=0
# /healthz is public, so it reports liveness only. Set to 1 temporarily when
# diagnosing to see the resolved endpoint and deployment name, then set back.
HEALTH_DETAIL=0

# --- Clarity (internal analytics, port 5000) --------------------------------
# Reasoning depth is worth the latency here; only staff wait on it.
CLARITY_PORT=5000
CLARITY_REASONING_EFFORT=medium
CLARITY_VERBOSITY=medium
CLARITY_TEMPERATURE=0.2
CLARITY_MAX_TOKENS=4000
CLARITY_MAX_TOOL_ROUNDS=3

# --- Nibbles (customer facing, port 5001) -----------------------------------
# Customers wait in real time, so keep reasoning minimal for fast first tokens.
NIBBLES_PORT=5001
NIBBLES_REASONING_EFFORT=minimal
NIBBLES_VERBOSITY=low
NIBBLES_TEMPERATURE=0.55
NIBBLES_MAX_TOKENS=700
NIBBLES_MAX_ITEMS=5
LEADS_FILE=data/runtime/nibbles_leads.csv
